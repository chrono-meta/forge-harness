#!/bin/bash
# blind-birth-test instrument shim (2026-11-10, v2): consumer-like surface for every arm.
# Drops user-scope settings (operator plugins/hooks); acceptEdits; --add-dir .. = the rep's own wrapper (clone + project).
exec {HOME}/.local/bin/claude "$@" --setting-sources project,local --permission-mode acceptEdits --add-dir .. --settings {SCRATCH}/arm_settings.json
